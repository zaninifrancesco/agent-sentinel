{
  "PreToolUse": [
    {
      "matcher": "^(Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|WebFetch|WebSearch)$",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.sh",
          "timeout": 6
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|WebFetch|WebSearch)$",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.sh",
          "timeout": 6
        }
      ]
    }
  ],
  "PostToolUseFailure": [
    {
      "matcher": "^(Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep|WebFetch|WebSearch)$",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.sh",
          "timeout": 6
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.sh",
          "timeout": 6
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/scripts/claude-hook.sh",
          "timeout": 6
        }
      ]
    }
  ]
}
